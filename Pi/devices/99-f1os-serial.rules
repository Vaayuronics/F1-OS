# F1-OS Udev rules for Raspberry Pi Pico and Arduino serial devices
# This file creates persistent device names: /dev/pico and /dev/arduino
#
# IMPORTANT: This file should NOT replace the system's 99-com.rules file
# which is generated by Raspberry Pi OS for GPIO, I2C, SPI, etc.
#
# To install:
# sudo cp 99-f1os-serial.rules /etc/udev/rules.d/
# sudo udevadm control --reload-rules
# sudo udevadm trigger
# Then unplug/replug devices or reboot

# Raspberry Pi Pico (MicroPython)
# Vendor: 2e8a (Raspberry Pi), Product: 0005, Serial: e66130100f1f7128
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0005", ATTRS{serial}=="e66130100f1f7128", SYMLINK+="pico", MODE="0666"

# Arduino Uno R3
# Vendor: 2341 (Arduino SA), Product: 0043, Serial: 3423932333935181A1F0
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", ATTRS{serial}=="3423932333935181A1F0", SYMLINK+="arduino", MODE="0666"
